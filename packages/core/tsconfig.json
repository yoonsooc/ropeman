{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"paths": { "$lib/*": ["../../src/lib/*"] }
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"vite.config.ts",
		"../../src/lib/types/file-system.d.ts"
	]
}
