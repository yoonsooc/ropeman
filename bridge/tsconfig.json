{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"paths": { "$lib/*": ["../src/lib/*"] }
	},
	"include": ["src/**/*.ts", "vite.config.ts", "../src/lib/types/file-system.d.ts"]
}
