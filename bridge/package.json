{
	"name": "@ropeman/bridge",
	"version": "0.3.0",
	"license": "MIT",
	"description": "Local server and commands for Ropeman: maps a folder, checks the names your coding agent gives it, and serves it to the viewer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yoonsooc/ropeman.git",
		"directory": "bridge"
	},
	"type": "module",
	"bin": {
		"ropeman": "./dist/server.mjs",
		"ropeman-bridge": "./dist/server.mjs"
	},
	"scripts": {
		"build": "npm --prefix .. run build:bridge",
		"prepack": "npm --prefix .. run build && npm run build && npm --prefix .. run bundle:viewer",
		"start": "node dist/server.mjs"
	},
	"dependencies": {
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/ws": "^8.5.13",
		"@types/node": "^22.0.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	}
}
