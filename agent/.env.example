# Copy to .env (never commit .env)
DATABASE_URL=postgresql://ropeman:ropeman@localhost:5433/ropeman

# Answer generation: anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Embeddings: local (fastembed, runs on this machine) | gemini (needs GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_DIM=768
# For EMBEDDING_PROVIDER=gemini: EMBEDDING_MODEL=gemini-embedding-001

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash
