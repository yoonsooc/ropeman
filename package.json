{
	"name": "ropeman",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:core": "vite build -c packages/core/vite.config.ts",
		"check:core": "tsc -p packages/core/tsconfig.json",
		"build:bridge": "vite build -c bridge/vite.config.ts",
		"check:bridge": "tsc -p bridge/tsconfig.json",
		"bundle:viewer": "node scripts/bundle-viewer.mjs",
		"preview": "npm run build && wrangler dev",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"prepare": "svelte-kit sync && husky",
		"gen": "wrangler types",
		"deploy": "npm run build && npx wrangler pages deploy .svelte-kit/cloudflare --project-name=ropeman --branch=main --commit-dirty=false",
		"deploy:app": "npm run deploy",
		"deploy:edge:demo": "npm --prefix workers run deploy:demo",
		"deploy:edge:proxy": "npm --prefix workers run deploy:proxy",
		"deploy:edge:share": "npm --prefix workers run deploy:share",
		"deploy:edge:explore": "npm --prefix workers run deploy:explore",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tsconfig/svelte": "^5.0.9",
		"@types/node": "^25.3.3",
		"@types/prismjs": "^1.26.6",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.1",
		"mdsvex": "^0.12.8",
		"playwright": "^1.58.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.0",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.57.3",
		"svelte-eslint-parser": "^1.5.1",
		"tree-sitter-wasms": "^0.1.13",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^6.3.5",
		"vitest": "^4.0.18",
		"wrangler": "^4.160.1"
	},
	"dependencies": {
		"@dagrejs/dagre": "^1.1.4",
		"@mlc-ai/web-llm": "^0.2.88",
		"@orama/orama": "^3.1.5",
		"@xyflow/svelte": "^1.7.1",
		"html-to-image": "^1.11.13",
		"marked": "^17.0.3",
		"prism-themes": "^1.9.0",
		"prismjs": "^1.30.0",
		"tree-sitter-c": "^0.24.1",
		"tree-sitter-cpp": "^0.23.4",
		"tree-sitter-go": "^0.25.0",
		"tree-sitter-java": "^0.23.5",
		"tree-sitter-rust": "^0.24.0",
		"web-tree-sitter": "^0.27.2"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"src/lib/services/**/*.ts": [
			"node scripts/check-test-exists.mjs"
		],
		"src/lib/stores/**/*.ts": [
			"node scripts/check-test-exists.mjs"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	}
}
